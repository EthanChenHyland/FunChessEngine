{
  "name": "funchessengine-desktop",
  "version": "1.1.0",
  "private": true,
  "author": "FunChessEngine",
  "description": "Desktop shell for FunChessEngine Engine Lab",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:icon && electron .",
    "dev": "npm run build:icon && electron .",
    "build:icon": "bash scripts/build-icon.sh",
    "build:backend": "node scripts/build-backend.js",
    "clean:dist": "node scripts/clean-dist.js",
    "build": "npm run build:mac",
    "build:mac": "npm run build:icon && npm run build:backend && npm run clean:dist && electron-builder --mac --arm64 && npm run verify:build",
    "build:linux": "npm run build:backend && npm run clean:dist && electron-builder --linux --x64",
    "build:win": "npm run build:backend && npm run clean:dist && electron-builder --win --x64",
    "check": "node --check main.js && node --check preload.js && node --check scripts/build-backend.js && node --check scripts/clean-dist.js && node --check scripts/notarize.js && node --check scripts/ui-smoke.js && node --check scripts/verify-build.js && bash -n scripts/build-icon.sh && node --check storage.js && node --check ../gui/static/workflows.js && node --check metadata-ipc.js",
    "verify:build": "node scripts/verify-build.js",
    "smoke:ui": "electron scripts/ui-smoke.js"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.funchessengine.enginelab",
    "productName": "FunChessEngine",
    "asar": true,
    "afterSign": "scripts/notarize.js",
    "fileAssociations": [
      {
        "ext": "pgn",
        "name": "Portable Game Notation",
        "role": "Editor"
      },
      {
        "ext": "fen",
        "name": "Chess FEN Position",
        "role": "Editor"
      },
      {
        "ext": "fce",
        "name": "FunChessEngine Legacy Metadata Backup",
        "role": "Editor"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "storage.js",
      "metadata-ipc.js"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "FunChessEngine-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "FunChessEngine ${version}"
    },
    "linux": {
      "category": "Game",
      "target": [
        "AppImage",
        "zip"
      ],
      "artifactName": "FunChessEngine-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "FunChessEngine-${version}-${arch}.${ext}"
    }
  }
}
