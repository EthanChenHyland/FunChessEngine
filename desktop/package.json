{
  "name": "funchessengine-desktop",
  "version": "0.4.2",
  "private": true,
  "author": "FunChessEngine",
  "description": "Desktop shell for FunChessEngine Engine Lab",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:icon && electron .",
    "dev": "npm run build:icon && electron .",
    "build:icon": "bash scripts/build-icon.sh",
    "build:backend": "node scripts/build-backend.js",
    "build": "npm run build:icon && npm run build:backend && rm -rf dist && electron-builder --mac --arm64",
    "check": "node --check main.js && node --check preload.js && node --check scripts/build-backend.js && bash -n scripts/build-icon.sh"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.funchessengine.enginelab",
    "productName": "FunChessEngine",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/funchess-backend",
        "to": "bin/funchess-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "FunChessEngine-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "FunChessEngine ${version}"
    }
  }
}
